WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_MAX_RESULTS=10
WEB_SEARCH_MAX_TOTAL_RESULTS=30
WEB_SEARCH_CONCURRENCY=3

DISCOVERY_CANDIDATE_MULTIPLIER=3
DISCOVERY_CANDIDATE_MAX=15

COMPANY_RESEARCH_QUERY_COUNT=5
COMPANY_RESEARCH_MAX_RESULTS_PER_QUERY=5
COMPANY_RESEARCH_MAX_RESULTS_PER_COMPANY=15

TAVILY_API_KEY=
