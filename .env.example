ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=console
OTEL_ENABLED=true
OTEL_SERVICE_NAME=virtual-company

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE_IO=false

LLM_PROVIDER=openai
LLM_RESEARCH_PROVIDER=
LLM_EXTRACTION_PROVIDER=

OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-5.6-terra
OPENAI_EXTRACTION_MODEL=gpt-5.6-luna

ANTHROPIC_API_KEY=
