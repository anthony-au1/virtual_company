ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=console
OTEL_ENABLED=true
OTEL_SERVICE_NAME=virtual-company

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE_IO=false

LLM_PROVIDER=openai
LLM_RESEARCH_PROVIDER=
LLM_EXTRACTION_PROVIDER=

OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-5.6-terra
OPENAI_EXTRACTION_MODEL=gpt-5.6-luna

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_MAX_RESULTS=10
WEB_SEARCH_MAX_TOTAL_RESULTS=30
WEB_SEARCH_CONCURRENCY=3

DISCOVERY_CANDIDATE_MULTIPLIER=3
DISCOVERY_CANDIDATE_MAX=15

COMPANY_RESEARCH_QUERY_COUNT=5
COMPANY_RESEARCH_MAX_RESULTS_PER_QUERY=5
COMPANY_RESEARCH_MAX_RESULTS_PER_COMPANY=15
COMPANY_RESEARCH_MAX_FETCHES_PER_COMPANY=5
COMPANY_RESEARCH_MAX_INVESTIGATION_ROUNDS=2
COMPANY_RESEARCH_FOLLOWUP_SEARCH_QUERIES_PER_COMPANY=3
COMPANY_RESEARCH_FOLLOWUP_MAX_FETCHES_PER_COMPANY=3

WEB_FETCH_TIMEOUT_SECONDS=15
WEB_FETCH_MAX_RESPONSE_BYTES=2000000
WEB_FETCH_MAX_CONTENT_CHARS=50000
WEB_FETCH_CONCURRENCY=5

TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic

EXA_API_KEY=
